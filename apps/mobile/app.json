    },
    "android": {
      "package": "io.rewritelab.jadxlearning",
      "adaptiveIcon": {
        "backgroundColor": "#0E1726"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-document-picker"
    ],
    "extra": {
      "contentRepository": "dmbs335/the-map",
      "analysisRepository": "dmbs335/jadx",
      "formalRepository": "rewrite-lab/websec-formal"
    }
  }
}
